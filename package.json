{
  "name": "worknest-studio",
  "version": "1.0.0",
  "private": true,
  "description": "WorkNest Studio — digital productivity template store on Cloudflare Pages",
  "type": "module",
  "scripts": {
    "generate": "python3 products/generate.py",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler pages dev",
    "upload-files": "python3 scripts/upload_r2.py",
    "deploy": "node scripts/deploy.mjs",
    "test": "node scripts/build.mjs && node tests/e2e.mjs"
  },
  "devDependencies": {
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=20"
  }
}
